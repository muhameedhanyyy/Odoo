<odoo>

    <!-- ========================= -->
    <!-- Patient List View -->
    <!-- ========================= -->

    <record id="view_patient_list"
            model="ir.ui.view">

        <field name="name">
            hms.patient.list
        </field>

        <field name="model">
            hms.patient
        </field>

        <field name="arch"
               type="xml">

            <list>

                <field name="first_name"/>

                <field name="last_name"/>

                <field name="age"/>

                <field name="blood_type"/>

                <field name="state"/>

            </list>

        </field>

    </record>


    <!-- ========================= -->
    <!-- Patient Form View -->
    <!-- ========================= -->

    <record id="view_patient_form"
            model="ir.ui.view">

        <field name="name">
            hms.patient.form
        </field>

        <field name="model">
            hms.patient
        </field>

        <field name="arch"
               type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="first_name"/>

                        <field name="last_name"/>

                        <field name="birth_date"/>

                        <field name="age"
                               readonly="1"/>

                        <field name="blood_type"/>

                        <field name="state"/>

                    </group>


                    <group>

                        <field name="department_id"/>

                        <field name="department_capacity"
                               readonly="1"/>

                        <field name="doctor_ids"
                               widget="many2many_tags"
                               attrs="{'readonly':[('department_id','=',False)]}"/>

                    </group>


                    <group>

                        <field name="pcr"/>

                        <field name="cr_ratio"
                               attrs="{'required':[('pcr','=',True)]}"/>

                    </group>


                    <group>

                        <field name="history"
                               attrs="{'invisible':[('age','&lt;',50)]}"/>

                    </group>


                    <group>

                        <field name="image"
                               widget="image"/>

                        <field name="address"/>

                    </group>


                    <notebook>

                        <page string="Logs">

                            <field name="log_ids">

                                <list>

                                    <field name="created_by"/>

                                    <field name="date"/>

                                    <field name="description"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ========================= -->
    <!-- Action -->
    <!-- ========================= -->

    <record id="patient_action"
            model="ir.actions.act_window">

        <field name="name">
            Patients
        </field>

        <field name="res_model">
            hms.patient
        </field>

        <field name="view_mode">
            list,form
        </field>

    </record>


    <!-- ========================= -->
    <!-- Main Menu -->
    <!-- ========================= -->

    <menuitem id="hms_main_menu"
              name="HMS"/>


    <!-- ========================= -->
    <!-- Patient Menu -->
    <!-- ========================= -->

    <menuitem id="patient_menu"
              name="Patients"
              parent="hms_main_menu"
              action="patient_action"/>

</odoo>
